#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <219>;
    #tapping-term-ms = <300>;
    flavor = "tap-preferred";
    #require-prior-idle-ms = <40>;  // Предотвращает случайные срабатывания при быстрой печати
};

&lt {
    #quick-tap-ms = <219>;
    #tapping-term-ms = <300>;
    flavor = "tap-preferred";
    #require-prior-idle-ms = <40>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Скобки — одновременное нажатие соседних клавиш

        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <21 22>;  // O + P
            bindings = <&kp RBKT>;    // ]
        };

        combo_equal {
            timeout-ms = <50>;
            key-positions = <20 21>;  // I + O
            bindings = <&kp EQUAL>;    // =
        };

        combo_minus {
            timeout-ms = <50>;
            key-positions = <19 20>;  // U + I
            bindings = <&kp MINUS>;    // -
        };

        // Переключение языка — J + K одновременно
        // Переключение языка с Shift — D + F одновременно (Right Command + Shift + Space)
    };

    macros {
        s: s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "S";
        };

        ch: ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp MINUS>;
            label = "CH";
        };

        tabLft: tabLft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(PG_UP)>;
            label = "TABLFT";
        };

        tabRght: tabRght {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(PAGE_DOWN)>;
            label = "TABRGHT";
        };

        weq: weq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp EQUAL>;
            label = "WEQ";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE   &kp N1            &kp N2          &kp N3          &kp N4            &kp N5          &kp N6          &kp N7             &kp N8           &kp N9          &kp N0               &kp BACKSPACE
&kp ESCAPE  &kp Q             &kp W           &kp E           &kp R             &kp T           &kp Y           &kp U              &kp I            &kp O           &kp P                &kp LBKT
&kp TAB     &mt LCTRL A       &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LEFT_SHIFT F  &kp G           &kp H           &mt RIGHT_SHIFT J  &mt RIGHT_GUI K  &mt LEFT_ALT L  &mt LCTRL SEMICOLON  &kp SQT
&kp LCTRL   &mt LEFT_SHIFT Z  &kp X           &kp C           &kp V             &kp B           &kp N           &kp M              &kp COMMA        &kp PERIOD      &kp FSLH             &kp RIGHT_SHIFT
                                              &lt 6 SPACE     &lt 1 SPACE       &lt 5 DELETE    &kp ENTER       &lt 3 BACKSPACE
                                                              &kp LGUI          &lt 2 DOWN      &lt 4 LEFT_GUI
            >;
        };

        snipe-layers {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP    &kp LS(C_AC_HOME)  &kp C_AC_SEARCH  &kp K_MUTE  &kp C_VOL_DN    &kp C_VOL_UP  &kp C_PREV      &kp C_PP  &kp C_NEXT       &kp MINUS  &kp EQUAL
&kp LEFT_ALT  &none           &none              &none            &none       &none           &none         &none           &none     &none            &none      &none
&kp TAB       &msc SCRL_UP    &mkp MCLK          &mkp RCLK        &mkp LCLK   &kp LC(A)       &kp LEFT      &kp DOWN_ARROW  &kp UP    &kp RIGHT_ARROW  &trans     &none
&kp LCTRL     &msc SCRL_DOWN  &tabLft            &tabRght         &none       &trans          &kp PG_UP     &kp PG_DN       &trans    &trans           &trans     &kp RSHFT
                                                 &trans           &trans      &trans          &mkp RCLK     &mkp LCLK
                                                                  &trans      &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans             &trans    &trans         &trans          &trans     &kp MINUS  &kp EQUAL
&trans  &trans  &trans  &trans  &trans          &trans             &kp HOME  &kp PAGE_UP    &msc SCRL_UP    &trans     &trans     &kp RBKT
&trans  &trans  &trans  &trans  &trans          &trans             &kp LEFT  &kp DOWN       &kp UP          &kp RIGHT  &trans     &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans          &trans             &kp END   &kp PAGE_DOWN  &msc SCRL_DOWN  &trans     &trans     &trans
                        &trans  &kp UP_ARROW    &kp RIGHT_ARROW    &trans    &trans
                                &kp LEFT_ARROW  &kp DOWN_ARROW     &trans
            >;
        };

        othr {
            bindings = <
&kp NUMBER_1  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6          &kp N7    &kp N8        &kp N9      &kp N0                &kp BACKSPACE
&trans        &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT     &kp CARET             &kp AMPS  &kp ASTRK     &trans      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp PERCENT   &kp EQUAL        &kp SLASH     &kp ASTERISK  &kp PLUS      &kp MINUS       &kp NON_US_BACKSLASH  &weq      &kp QUESTION  &trans      &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans        &kp LEFT_SHIFT   &trans        &trans        &ch           &s              &kp UNDERSCORE        &kp PIPE  &kp COMMA     &kp PERIOD  &kp LEFT_BRACE        &kp RIGHT_BRACE
                                             &trans        &trans        &trans          &kp C_VOLUME_UP       &trans
                                                           &trans        &trans          &kp C_VOL_DN
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        WINDOWS_LAYERS {
            bindings = <
&trans     &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)         &kp LG(NUMBER_6)  &kp LG(N7)        &kp LG(N8)          &kp LG(N9)     &kp LG(N0)  &trans
&trans     &trans            &trans            &trans            &trans            &trans             &kp LG(Y)         &kp LG(U)         &kp LG(I)           &kp LG(O)      &trans      &trans
&kp TAB    &msc SCRL_UP      &mkp MCLK         &mkp RCLK         &mkp LCLK         &kp C_VOLUME_UP    &kp LG(LEFT)      &kp LG(UP_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT)  &trans      &trans
&kp LCTRL  &kp LEFT_SHIFT    &tabLft           &tabRght          &msc SCRL_DOWN    &kp C_VOL_DN       &kp LG(N)         &kp LG(M)         &kp LG(COMMA)       &kp LG(DOT)    &trans      &kp RIGHT_SHIFT
                                               &trans            &trans            &trans             &trans            &trans
                                                                 &trans            &trans             &kp LG(ENTER)
            >;
        };

        // Layer 6: CARET — трекбол двигает текстовый курсор (стрелки) вместо мыши
        // Все клавиши прозрачны, клавиатура работает как обычно

        caret_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
